# Secrets for multi-source-churn-detector workflow.
# All secrets use $shared references resolved from <repo-root>/.secrets/.
# Run: tntc secrets init --shared (from the repo root)

analytics: $shared.analytics   # Product analytics API key
support: $shared.support       # Support ticketing API key
stripe: $shared.stripe         # Stripe API key for billing data
survey: $shared.survey         # Survey/NPS API key
rustfs: $shared.rustfs         # RustFS/S3 access credentials
postgres: $shared.postgres     # Postgres database password
anthropic: $shared.anthropic   # Anthropic API key for health scoring
slack: $shared.slack           # Slack webhook URL for alerts
