# Secrets for knowledge-base-rag workflow.
# All secrets use $shared references resolved from <repo-root>/.secrets/.
# Run: tntc secrets init --shared (from the repo root)

google: $shared.google         # Google OAuth access token (Drive API)
openai: $shared.openai         # OpenAI API key for embeddings
rustfs: $shared.rustfs         # RustFS/S3 access credentials
postgres: $shared.postgres     # Postgres database password
nats: $shared.nats             # NATS bearer token
anthropic: $shared.anthropic   # Anthropic API key for LLM generation
slack: $shared.slack           # Slack webhook URL
