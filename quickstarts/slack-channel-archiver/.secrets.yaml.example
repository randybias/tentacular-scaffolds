# Secrets for slack-channel-archiver workflow.
# All secrets use $shared references resolved from <repo-root>/.secrets/.
# Run: tntc secrets init --shared (from the repo root)

slack: $shared.slack           # Slack bot token for conversations.history API
rustfs: $shared.rustfs         # RustFS (S3-compatible) access key + secret key
postgres: $shared.postgres     # Postgres database password
