# Secrets for incident-response-orchestrator workflow.
# All secrets use $shared references resolved from <repo-root>/.secrets/.
# Run: tntc secrets init --shared (from the repo root)

github: $shared.github         # GitHub token for API access and issue creation
rustfs: $shared.rustfs         # RustFS/S3 access credentials for runbook storage
postgres: $shared.postgres     # Postgres database password
nats: $shared.nats             # NATS bearer token for event publishing
anthropic: $shared.anthropic   # Anthropic API key for severity classification
slack: $shared.slack           # Slack webhook URL for notifications
pagerduty: $shared.pagerduty   # PagerDuty API key for on-call paging
